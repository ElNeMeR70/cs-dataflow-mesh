<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>cs-dataflow-mesh</AssemblyName>
    <RootNamespace>dataflow_mesh</RootNamespace>
    <Description>TPL Dataflow mesh with join, broadcast, batch blocks</Description>
    <Authors>Mahmoud ElNemer</Authors>
    <PackageProjectUrl>https://github.com/ElNeMeR70/cs-dataflow-mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ElNeMeR70/cs-dataflow-mesh</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
